{
  "name": "dgo-internal-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NITDA DGO internal operator platform. A static ES-module browser application, deployed as-is: what is committed here is what is served.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/verify.mjs",
    "test:secrets": "node tests/verify.mjs --only=secrets",
    "test:imports": "node tests/verify.mjs --only=imports",
    "test:entry": "node tests/verify.mjs --only=entry",
    "test:syntax": "node tests/verify.mjs --only=syntax",
    "start": "npx --yes http-server . -p 8080 --cors -c-1 --silent"
  }
}
