      "Compose_List_Collection_Plan_Template": {
        "type": "Compose",
        "inputs": [
          {
            "key": "fields",
            "suffix": "/fields?$top=5000"
          },
          {
            "key": "contentTypes",
            "suffix": "/ContentTypes?$expand=FieldLinks&$top=5000"
          },
          {
            "key": "views",
            "suffix": "/Views?$expand=ViewFields&$top=5000"
          },
          {
            "key": "workflowAssociations",
            "suffix": "/WorkflowAssociations?$top=5000"
          },
