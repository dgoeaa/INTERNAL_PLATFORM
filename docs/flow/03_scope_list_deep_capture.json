            "suffix": "/RootFolder?$expand=StorageMetrics,Properties"
          },
          {
            "key": "roleAssignments",
            "suffix": "/RoleAssignments?$expand=Member,RoleDefinitionBindings&$top=5000"
          }
        ],
        "runAfter": {
          "Compose_Base_Template_Catalog": [
            "Succeeded"
          ]
        }
      },
      "Filter_Lists_For_Deep_Capture": {
        "type": "Query",
        "inputs": {
          "from": "@variables('varAllListsRaw')",
          "where": "@or(equals(variables('varIncludeHiddenLists'), true), not(equals(item()?['Hidden'], true)))"
        },
        "runAfter": {
          "Compose_List_Collection_Plan_Template": [
            "Succeeded"
          ]
        }
      },
      "Apply_to_each_List_Or_Library": {
        "type": "Foreach",
        "foreach": "@body('Filter_Lists_For_Deep_Capture')",
        "actions": {
          "Set_varListCollections_Reset": {
            "type": "SetVariable",
            "inputs": {
              "name": "varListCollections",
              "value": "@json('{}')"
            }
          },
          "Set_varListRetrievalStatus_Reset": {
            "type": "SetVariable",
            "inputs": {
              "name": "varListRetrievalStatus",
              "value": "@json('{}')"
            },
            "runAfter": {
              "Set_varListCollections_Reset": [
                "Succeeded"
              ]
            }
          },
          "Filter_List_Collection_Plan": {
            "type": "Query",
            "inputs": {
              "from": "@outputs('Compose_List_Collection_Plan_Template')",
              "where": "@or(not(equals(item()?['key'], 'roleAssignments')), equals(items('Apply_to_each_List_Or_Library')?['HasUniqueRoleAssignments'], true))"
            },
            "runAfter": {
              "Set_varListRetrievalStatus_Reset": [
                "Succeeded"
              ]
            }
          },
          "Select_List_Collection_Plan": {
            "type": "Select",
            "inputs": {
              "from": "@body('Filter_List_Collection_Plan')",
              "select": {
                "key": "@item()?['key']",
                "uri": "@concat('_api/web/lists(guid''', items('Apply_to_each_List_Or_Library')?['Id'], ''')', item()?['suffix'])"
              }
            },
            "runAfter": {
              "Filter_List_Collection_Plan": [
                "Succeeded"
              ]
            }
          },
          "Apply_to_each_List_Collection": {
            "type": "Foreach",
            "foreach": "@body('Select_List_Collection_Plan')",
            "actions": {
              "Set_varCollectionAccumulator_Reset_List": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varCollectionAccumulator",
                  "value": []
                }
              },
              "Set_varCollectionNextUri_Seed_List": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varCollectionNextUri",
                  "value": "@items('Apply_to_each_List_Collection')?['uri']"
                },
                "runAfter": {
                  "Set_varCollectionAccumulator_Reset_List": [
                    "Succeeded"
                  ]
                }
              },
              "Set_varCollectionPagingDone_Reset_List": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varCollectionPagingDone",
                  "value": false
                },
                "runAfter": {
                  "Set_varCollectionNextUri_Seed_List": [
                    "Succeeded"
                  ]
                }
              },
              "Until_List_Collection_Paged": {
                "type": "Until",
                "expression": "@equals(variables('varCollectionPagingDone'), true)",
                "limit": {
                  "count": 500,
                  "timeout": "PT1H"
                },
                "actions": {
                  "GET_List_Collection_Page": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "parameters": {
                        "dataset": "@items('Apply_to_each_List_Or_Library')?['__webUrl']",
                        "parameters/method": "GET",
                        "parameters/uri": "@variables('varCollectionNextUri')",
                        "parameters/headers": {
                          "Accept": "application/json;odata=nometadata",
                          "Content-Type": "application/json;odata=nometadata"
                        }
                      },
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connection": "shared_sharepointonline",
                        "operationId": "HttpRequest"
                      }
                    },
                    "runtimeConfiguration": {
                      "retryPolicy": {
                        "type": "exponential",
                        "count": 4,
                        "interval": "PT10S",
                        "minimumInterval": "PT5S",
                        "maximumInterval": "PT1H"
                      }
                    }
                  },
                  "Compose_List_Collection_Page_Items": {
                    "type": "Compose",
                    "inputs": "@if(equals(actions('GET_List_Collection_Page')?['status'], 'Succeeded'), coalesce(body('GET_List_Collection_Page')?['value'], createArray(body('GET_List_Collection_Page'))), createArray())",
                    "runAfter": {
                      "GET_List_Collection_Page": [
                        "Succeeded",
                        "Failed",
                        "Skipped",
                        "TimedOut"
                      ]
                    }
                  },
                  "Set_varCollectionAccumulator_Append_List": {
                    "type": "Foreach",
                    "foreach": "@outputs('Compose_List_Collection_Page_Items')",
                    "actions": {
                      "Append_Set_varCollectionAccumulator_Append_List": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "varCollectionAccumulator",
                          "value": "@item()"
                        }
                      }
                    },
                    "runAfter": {
                      "Compose_List_Collection_Page_Items": [
                        "Succeeded"
                      ]
                    },
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 1
                      }
                    }
                  },
                  "Compose_List_Collection_Next_Link": {
                    "type": "Compose",
                    "inputs": "@if(equals(actions('GET_List_Collection_Page')?['status'], 'Succeeded'), string(coalesce(body('GET_List_Collection_Page')?['odata.nextLink'], '')), '')",
                    "runAfter": {
                      "Set_varCollectionAccumulator_Append_List": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Set_varCollectionNextUri_Next_List": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varCollectionNextUri",
                      "value": "@if(contains(outputs('Compose_List_Collection_Next_Link'), '/_api/'), concat('_api/', last(split(outputs('Compose_List_Collection_Next_Link'), '/_api/'))), '')"
                    },
                    "runAfter": {
                      "Compose_List_Collection_Next_Link": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Set_varCollectionPagingDone_List": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varCollectionPagingDone",
                      "value": "@empty(variables('varCollectionNextUri'))"
                    },
                    "runAfter": {
                      "Set_varCollectionNextUri_Next_List": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "runAfter": {
                  "Set_varCollectionPagingDone_Reset_List": [
                    "Succeeded"
                  ]
                }
              },
              "Set_varListCollections_Store": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varListCollections",
                  "value": "@setProperty(variables('varListCollections'), items('Apply_to_each_List_Collection')?['key'], variables('varCollectionAccumulator'))"
                },
                "runAfter": {
                  "Until_List_Collection_Paged": [
                    "Succeeded"
                  ]
                }
              },
              "Set_varListRetrievalStatus_Store": {
                "type": "SetVariable",
                "inputs": {
                  "name": "varListRetrievalStatus",
                  "value": "@setProperty(variables('varListRetrievalStatus'), items('Apply_to_each_List_Collection')?['key'], string(actions('GET_List_Collection_Page')?['status']))"
                },
                "runAfter": {
                  "Set_varListCollections_Store": [
                    "Succeeded"
                  ]
                }
              },
              "Condition_Log_List_Collection_Error": {
                "type": "If",
                "expression": {
                  "not": {
                    "equals": [
                      "@actions('GET_List_Collection_Page')?['status']",
                      "Succeeded"
                    ]
                  }
                },
                "actions": {
                  "Append_Error_List_Collection": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "varSPInventoryErrors",
                      "value": {
                        "runId": "@variables('varRunId')",
                        "capturedAtUtc": "@utcNow()",
                        "severity": "High",
                        "stage": "GET_List_Collection",
                        "collection": "@items('Apply_to_each_List_Collection')?['key']",
                        "siteUrl": "@items('Apply_to_each_List_Or_Library')?['__webUrl']",
                        "listId": "@items('Apply_to_each_List_Or_Library')?['Id']",
                        "listTitle": "@items('Apply_to_each_List_Or_Library')?['Title']",
                        "endpoint": "@items('Apply_to_each_List_Collection')?['uri']",
                        "status": "@actions('GET_List_Collection_Page')?['status']",
                        "httpStatus": "@coalesce(outputs('GET_List_Collection_Page')?['statusCode'], 0)",
                        "message": "@coalesce(body('GET_List_Collection_Page')?['error']?['message'], body('GET_List_Collection_Page')?['message'], string(coalesce(body('GET_List_Collection_Page'), '')), '')"
                      }
                    }
                  }
                },
                "else": {
                  "actions": {}
                },
                "runAfter": {
                  "Set_varListRetrievalStatus_Store": [
                    "Succeeded"
                  ]
                }
              }
            },
            "runAfter": {
              "Select_List_Collection_Plan": [
                "Succeeded"
              ]
            },
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 1
              }
            }
          },
          "Select_Normalized_Fields_For_Current_List": {
            "type": "Select",
            "inputs": {
              "from": "@coalesce(variables('varListCollections')?['fields'], createArray())",
              "select": {
                "fieldId": "@item()?['Id']",
                "title": "@item()?['Title']",
                "internalName": "@item()?['InternalName']",
                "staticName": "@item()?['StaticName']",
                "entityPropertyName": "@item()?['EntityPropertyName']",
                "typeAsString": "@item()?['TypeAsString']",
                "typeDisplayName": "@item()?['TypeDisplayName']",
                "fieldTypeKind": "@item()?['FieldTypeKind']",
                "description": "@item()?['Description']",
                "group": "@item()?['Group']",
                "defaultValue": "@item()?['DefaultValue']",
                "required": "@equals(item()?['Required'], true)",
                "hidden": "@equals(item()?['Hidden'], true)",
                "readOnly": "@equals(item()?['ReadOnlyField'], true)",
                "sealed": "@equals(item()?['Sealed'], true)",
                "canBeDeleted": "@equals(item()?['CanBeDeleted'], true)",
                "fromBaseType": "@equals(item()?['FromBaseType'], true)",
                "indexed": "@equals(item()?['Indexed'], true)",
                "enforceUniqueValues": "@equals(item()?['EnforceUniqueValues'], true)",
                "sortable": "@equals(item()?['Sortable'], true)",
                "filterable": "@equals(item()?['Filterable'], true)",
                "choices": "@coalesce(item()?['Choices'], createArray())",
                "lookupListId": "@string(coalesce(item()?['LookupList'], ''))",
                "lookupField": "@string(coalesce(item()?['LookupField'], ''))",
                "lookupWebId": "@string(coalesce(item()?['LookupWebId'], ''))",
                "allowMultipleValues": "@equals(item()?['AllowMultipleValues'], true)",
                "relationshipDeleteBehavior": "@item()?['RelationshipDeleteBehavior']",
                "termSetId": "@string(coalesce(item()?['TermSetId'], ''))",
                "termStoreId": "@string(coalesce(item()?['SspId'], ''))",
                "anchorId": "@string(coalesce(item()?['AnchorId'], ''))",
                "isPathRendered": "@equals(item()?['IsPathRendered'], true)",
                "isKeyword": "@equals(item()?['IsKeyword'], true)",
                "openTermCreation": "@equals(item()?['Open'], true)",
                "formula": "@string(coalesce(item()?['Formula'], ''))",
                "outputType": "@item()?['OutputType']",
                "maxLength": "@item()?['MaxLength']",
                "numberOfLines": "@item()?['NumberOfLines']",
                "richText": "@equals(item()?['RichText'], true)",
                "appendOnly": "@equals(item()?['AppendOnly'], true)",
                "displayFormat": "@item()?['DisplayFormat']",
                "dateTimeCalendarType": "@item()?['DateTimeCalendarType']",
                "minimumValue": "@item()?['MinimumValue']",
                "maximumValue": "@item()?['MaximumValue']",
                "currencyLocaleId": "@item()?['CurrencyLocaleId']",
                "validationFormula": "@string(coalesce(item()?['ValidationFormula'], ''))",
                "validationMessage": "@string(coalesce(item()?['ValidationMessage'], ''))",
                "schemaXml": "@if(equals(variables('varIncludeSchemaXml'), true), string(coalesce(item()?['SchemaXml'], '')), '')",
                "isCustomBusinessMetadata": "@and(not(equals(item()?['FromBaseType'], true)), equals(item()?['CanBeDeleted'], true), not(equals(item()?['Hidden'], true)))",
                "isSystemField": "@or(equals(item()?['Hidden'], true), equals(item()?['ReadOnlyField'], true), equals(item()?['Sealed'], true), equals(item()?['FromBaseType'], true))",
                "isGovernanceRelevant": "@or(equals(item()?['Required'], true), equals(item()?['EnforceUniqueValues'], true), equals(item()?['Indexed'], true), contains(createArray('TaxonomyFieldType','TaxonomyFieldTypeMulti','User','UserMulti','Lookup','LookupMulti','DateTime'), string(item()?['TypeAsString'])))",
                "fieldClassification": "@if(equals(item()?['Hidden'], true), 'Hidden Field', if(equals(item()?['Sealed'], true), 'Sealed/System Field', if(equals(item()?['ReadOnlyField'], true), 'Read-only Field', if(contains(createArray('TaxonomyFieldType','TaxonomyFieldTypeMulti'), string(item()?['TypeAsString'])), 'Managed Metadata Field', if(contains(createArray('User','UserMulti'), string(item()?['TypeAsString'])), 'Person/Group Field', if(contains(createArray('Lookup','LookupMulti'), string(item()?['TypeAsString'])), 'Lookup/Relationship Field', if(equals(item()?['TypeAsString'], 'DateTime'), 'Date/Retention Field', if(and(not(equals(item()?['FromBaseType'], true)), equals(item()?['CanBeDeleted'], true)), 'Custom Business Metadata', 'Default SharePoint Field'))))))))"
              }
            },
            "runAfter": {
              "Apply_to_each_List_Collection": [
                "Succeeded"
              ]
            }
          },
          "Filter_Custom_Metadata_Fields": {
            "type": "Query",
            "inputs": {
              "from": "@body('Select_Normalized_Fields_For_Current_List')",
              "where": "@equals(item()?['isCustomBusinessMetadata'], true)"
            },
            "runAfter": {
              "Select_Normalized_Fields_For_Current_List": [
                "Succeeded"
              ]
            }
          },
          "Filter_Hidden_Fields": {
            "type": "Query",
            "inputs": {
              "from": "@body('Select_Normalized_Fields_For_Current_List')",
              "where": "@equals(item()?['hidden'], true)"
            },
            "runAfter": {
              "Filter_Custom_Metadata_Fields": [
                "Succeeded"
              ]
            }
          },
          "Filter_Required_Fields": {
            "type": "Query",
            "inputs": {
              "from": "@body('Select_Normalized_Fields_For_Current_List')",
              "where": "@equals(item()?['required'], true)"
            },
            "runAfter": {
              "Filter_Hidden_Fields": [
                "Succeeded"
              ]
            }
          },
          "Filter_Governance_Fields": {
            "type": "Query",
            "inputs": {
              "from": "@body('Select_Normalized_Fields_For_Current_List')",
              "where": "@equals(item()?['isGovernanceRelevant'], true)"
            },
            "runAfter": {
              "Filter_Required_Fields": [
                "Succeeded"
              ]
            }
          },
          "Filter_Base_Template_Match": {
            "type": "Query",
            "inputs": {
              "from": "@outputs('Compose_Base_Template_Catalog')",
              "where": "@equals(item()?['template'], int(coalesce(items('Apply_to_each_List_Or_Library')?['BaseTemplate'], 0)))"
            },
            "runAfter": {
              "Filter_Governance_Fields": [
                "Succeeded"
              ]
            }
          },
          "Compose_Object_Kind": {
            "type": "Compose",
            "inputs": "@string(coalesce(first(body('Filter_Base_Template_Match'))?['kind'], concat('Other SharePoint Object (template ', string(coalesce(items('Apply_to_each_List_Or_Library')?['BaseTemplate'], 0)), ')')))",
            "runAfter": {
              "Filter_Base_Template_Match": [
                "Succeeded"
              ]
            }
          },
          "Compose_Object_Category": {
            "type": "Compose",
            "inputs": "@string(coalesce(first(body('Filter_Base_Template_Match'))?['category'], 'Unknown'))",
            "runAfter": {
              "Compose_Object_Kind": [
                "Succeeded"
              ]
            }
          },
          "Compose_Architecture_Classification": {
            "type": "Compose",
            "inputs": "@if(or(equals(items('Apply_to_each_List_Or_Library')?['IsCatalog'], true), equals(items('Apply_to_each_List_Or_Library')?['IsApplicationList'], true)), 'System/Internal Catalog', if(equals(items('Apply_to_each_List_Or_Library')?['IsSystemList'], true), 'System List', if(equals(items('Apply_to_each_List_Or_Library')?['Hidden'], true), 'Hidden/System Object', if(equals(outputs('Compose_Object_Category'), 'System'), 'System/Internal List', if(equals(outputs('Compose_Object_Category'), 'Library'), 'Business Document Library', if(equals(outputs('Compose_Object_Category'), 'List'), 'Business List', 'Unclassified SharePoint Object'))))))",
            "runAfter": {
              "Compose_Object_Category": [
                "Succeeded"
              ]
            }
          },
