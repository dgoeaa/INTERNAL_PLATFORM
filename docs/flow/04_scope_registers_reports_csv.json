          "errors": "@variables('varSPInventoryErrors')"
        },
        "runAfter": {
          "Compose_Run_Summary": [
            "Succeeded"
          ]
        }
      },
      "Compose_Normalized_Register": {
        "type": "Compose",
        "inputs": {
          "schemaVersion": "3.0",
          "outputType": "NormalizedArchitectureMetadataRegister",
          "summary": "@outputs('Compose_Run_Summary')",
          "objects": "@variables('varNormalizedObjects')"
        },
        "runAfter": {
          "Compose_Full_Raw_Metadata": [
            "Succeeded"
          ]
        }
      },
      "Filter_Findings_High": {
        "type": "Query",
        "inputs": {
          "from": "@variables('varQualityFindings')",
          "where": "@equals(item()?['severity'], 'High')"
        },
