          "select": "@concat('<tr><td>', replace(replace(replace(replace(replace(string(coalesce(item()?['title'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%22'), '&quot;'), decodeUriComponent('%27'), '&#39;'), '</td><td>', replace(replace(replace(replace(replace(string(coalesce(item()?['objectKind'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%22'), '&quot;'), decodeUriComponent('%27'), '&#39;'), '</td><td>', replace(replace(replace(replace(replace(string(coalesce(item()?['architectureClassification'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%22'), '&quot;'), decodeUriComponent('%27'), '&#39;'), '</td><td class=\"c\">', replace(replace(replace(replace(replace(string(coalesce(item()?['businessRelevance'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%22'), '&quot;'), decodeUriComponent('%27'), '&#39;'), '</td><td class=\"n\">', string(item()?['itemCount']), '</td><td class=\"n\">', string(div(int(coalesce(item()?['storage']?['totalSizeBytes'], 0)), 1048576)), '</td><td class=\"c\">', string(item()?['settings']?['enableVersioning']), '</td><td class=\"c\">', string(item()?['settings']?['contentTypesEnabled']), '</td><td class=\"c\">', string(item()?['settings']?['hasUniqueRoleAssignments']), '</td><td class=\"c\">', string(item()?['hasRetentionLabel']), '</td><td class=\"n\">', string(item()?['metrics']?['totalFields']), '</td><td class=\"n\">', string(item()?['metrics']?['customFields']), '</td><td>', replace(replace(replace(replace(replace(string(coalesce(item()?['serverRelativeUrl'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%22'), '&quot;'), decodeUriComponent('%27'), '&#39;'), '</td><td>', replace(replace(replace(replace(replace(string(coalesce(item()?['recommendedAction'], '')), '&', '&amp;'), '<', '&lt;'), '>', '&gt;'), decodeUriComponent('%22'), '&quot;'), decodeUriComponent('%27'), '&#39;'), '</td></tr>')"
