                "roleDefinitions": "@coalesce(variables('varWebCollections')?['roleDefinitions'], createArray())",
                "webRoleAssignments": "@coalesce(variables('varWebCollections')?['webRoleAssignments'], createArray())",
                "features": "@coalesce(variables('varWebCollections')?['features'], createArray())",
                "subWebUrls": "@body('Filter_Sub_Web_Urls')",
                "counts": {
                  "lists": "@length(coalesce(variables('varWebCollections')?['lists'], createArray()))",
                  "siteColumns": "@length(coalesce(variables('varWebCollections')?['siteColumns'], createArray()))",
                  "siteContentTypes": "@length(coalesce(variables('varWebCollections')?['siteContentTypes'], createArray()))",
                  "siteUsers": "@length(coalesce(variables('varWebCollections')?['siteUsers'], createArray()))",
                  "siteGroups": "@length(coalesce(variables('varWebCollections')?['siteGroups'], createArray()))",
                  "webRoleAssignments": "@length(coalesce(variables('varWebCollections')?['webRoleAssignments'], createArray()))",
                  "features": "@length(coalesce(variables('varWebCollections')?['features'], createArray()))",
                  "subWebs": "@length(body('Filter_Sub_Web_Urls'))"
                },
                "retrievalStatus": {
                  "web": "@actions('GET_Web_Properties')?['status']",
                  "allProperties": "@actions('GET_Web_All_Properties')?['status']",
                  "regionalSettings": "@actions('GET_Web_Regional_Settings')?['status']",
                  "associatedGroups": "@actions('GET_Web_Associated_Groups')?['status']",
                  "navigation": "@actions('GET_Web_Navigation')?['status']",
                  "effectiveBasePermissions": "@actions('GET_Web_Effective_Permissions')?['status']"
                }
              }
            },
            "runAfter": {
              "Set_varWebQueue_Enqueue": [
                "Succeeded"
              ]
            }
          },
          "Compose_Web_Stage_Statuses": {
            "type": "Compose",
            "inputs": [
              {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "High",
                "stage": "GET_Web_Properties",
                "siteUrl": "@variables('varCurrentWebUrl')",
                "status": "@actions('GET_Web_Properties')?['status']",
                "httpStatus": "@coalesce(outputs('GET_Web_Properties')?['statusCode'], 0)",
                "message": "@coalesce(body('GET_Web_Properties')?['error']?['message'], body('GET_Web_Properties')?['message'], string(coalesce(body('GET_Web_Properties'), '')), '')"
              },
              {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "High",
                "stage": "GET_Web_All_Properties",
                "siteUrl": "@variables('varCurrentWebUrl')",
                "status": "@actions('GET_Web_All_Properties')?['status']",
                "httpStatus": "@coalesce(outputs('GET_Web_All_Properties')?['statusCode'], 0)",
                "message": "@coalesce(body('GET_Web_All_Properties')?['error']?['message'], body('GET_Web_All_Properties')?['message'], string(coalesce(body('GET_Web_All_Properties'), '')), '')"
              },
              {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "High",
                "stage": "GET_Web_Regional_Settings",
                "siteUrl": "@variables('varCurrentWebUrl')",
                "status": "@actions('GET_Web_Regional_Settings')?['status']",
                "httpStatus": "@coalesce(outputs('GET_Web_Regional_Settings')?['statusCode'], 0)",
                "message": "@coalesce(body('GET_Web_Regional_Settings')?['error']?['message'], body('GET_Web_Regional_Settings')?['message'], string(coalesce(body('GET_Web_Regional_Settings'), '')), '')"
              },
              {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "High",
                "stage": "GET_Web_Associated_Groups",
                "siteUrl": "@variables('varCurrentWebUrl')",
                "status": "@actions('GET_Web_Associated_Groups')?['status']",
                "httpStatus": "@coalesce(outputs('GET_Web_Associated_Groups')?['statusCode'], 0)",
                "message": "@coalesce(body('GET_Web_Associated_Groups')?['error']?['message'], body('GET_Web_Associated_Groups')?['message'], string(coalesce(body('GET_Web_Associated_Groups'), '')), '')"
              },
              {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "High",
                "stage": "GET_Web_Navigation",
                "siteUrl": "@variables('varCurrentWebUrl')",
                "status": "@actions('GET_Web_Navigation')?['status']",
                "httpStatus": "@coalesce(outputs('GET_Web_Navigation')?['statusCode'], 0)",
                "message": "@coalesce(body('GET_Web_Navigation')?['error']?['message'], body('GET_Web_Navigation')?['message'], string(coalesce(body('GET_Web_Navigation'), '')), '')"
              },
              {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "High",
                "stage": "GET_Web_Effective_Permissions",
                "siteUrl": "@variables('varCurrentWebUrl')",
                "status": "@actions('GET_Web_Effective_Permissions')?['status']",
                "httpStatus": "@coalesce(outputs('GET_Web_Effective_Permissions')?['statusCode'], 0)",
                "message": "@coalesce(body('GET_Web_Effective_Permissions')?['error']?['message'], body('GET_Web_Effective_Permissions')?['message'], string(coalesce(body('GET_Web_Effective_Permissions'), '')), '')"
              }
            ],
            "runAfter": {
              "Append_Web_Capture_Record": [
                "Succeeded"
              ]
            }
          },
          "Filter_Web_Stage_Errors": {
            "type": "Query",
            "inputs": {
              "from": "@outputs('Compose_Web_Stage_Statuses')",
              "where": "@not(equals(item()?['status'], 'Succeeded'))"
            },
            "runAfter": {
              "Compose_Web_Stage_Statuses": [
                "Succeeded"
              ]
            }
          },
          "Set_varSPInventoryErrors_Web": {
            "type": "SetVariable",
            "inputs": {
              "name": "varSPInventoryErrors",
              "value": "@concat(variables('varSPInventoryErrors'), body('Filter_Web_Stage_Errors'))"
            },
            "runAfter": {
              "Filter_Web_Stage_Errors": [
                "Succeeded"
              ]
            }
          },
          "Set_varWebTraversalDone": {
            "type": "SetVariable",
            "inputs": {
              "name": "varWebTraversalDone",
              "value": "@or(empty(variables('varWebQueue')), greaterOrEquals(length(variables('varWebsCaptured')), variables('varMaxWebs')))"
            },
            "runAfter": {
              "Set_varSPInventoryErrors_Web": [
                "Succeeded"
              ]
            }
          }
        },
        "runAfter": {
          "Compose_Site_Usage_Safe": [
            "Succeeded"
          ]
        }
      },
      "Condition_Warn_Web_Traversal_Cap": {
        "type": "If",
        "expression": {
          "and": [
            {
              "not": {
                "equals": [
                  "@length(variables('varWebQueue'))",
                  0
                ]
              }
            }
          ]
        },
        "actions": {
          "Append_Warning_Traversal_Cap": {
            "type": "AppendToArrayVariable",
            "inputs": {
              "name": "varInventoryWarnings",
              "value": {
                "runId": "@variables('varRunId')",
                "capturedAtUtc": "@utcNow()",
                "severity": "Medium",
                "stage": "Until_Web_Traversal",
                "message": "@concat('Web traversal stopped at the varMaxWebs cap of ', string(variables('varMaxWebs')), ' webs. ', string(length(variables('varWebQueue'))), ' web(s) were left uncaptured.')",
                "uncapturedWebUrls": "@variables('varWebQueue')"
              }
            }
          }
        },
        "else": {
          "actions": {}
        },
        "runAfter": {
          "Until_Web_Traversal": [
            "Succeeded"
          ]
        }
      },
      "Compose_Site_And_Web_Checkpoint": {
        "type": "Compose",
        "inputs": {
          "websCaptured": "@length(variables('varWebsCaptured'))",
          "listsDiscovered": "@length(variables('varAllListsRaw'))",
          "websLeftUncaptured": "@length(variables('varWebQueue'))",
          "errorsLogged": "@length(variables('varSPInventoryErrors'))",
          "warningsLogged": "@length(variables('varInventoryWarnings'))"
        },
        "runAfter": {
          "Condition_Warn_Web_Traversal_Cap": [
            "Succeeded",
            "Skipped"
          ]
        }
      }
    },
    "runAfter": {
      "Scope_PREP_01_Run_Context": [
        "Succeeded"
      ]
    }
